# ---------------------------------------------------------------------------
# Required — the server refuses to start without these
# ---------------------------------------------------------------------------
# Local development:  mongodb://127.0.0.1:27017/medconsult
# MongoDB Atlas:      mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/medconsult
MONGO_URI=mongodb://127.0.0.1:27017/medconsult

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API.
# In production add your Vercel URL, e.g. https://medconsult.vercel.app
CORS_ORIGINS=http://localhost:5173

# Used to build links inside emails.
CLIENT_URL=http://localhost:5173

# Turns off API rate limiting. For running the smoke-test scripts, which log
# in far more often than a real user would. Ignored entirely when
# NODE_ENV=production, so it cannot weaken a deployed instance.
DISABLE_RATE_LIMITS=false

# ---------------------------------------------------------------------------
# Video consultation
# ---------------------------------------------------------------------------
# 'agora' uses the Agora SDK with server-minted tokens (needs the keys below).
# 'jitsi' embeds meet.jit.si instead and needs no keys at all — the demo-day
# fallback. If the Agora keys are missing the server falls back to jitsi
# automatically.
VIDEO_PROVIDER=agora

# Free "Starter" project at https://console.agora.io (10,000 min/month, no card).
# Enable the App Certificate in the project settings to get the second value.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600

# ---------------------------------------------------------------------------
# File storage — Cloudinary (free tier, no credit card)
# https://console.cloudinary.com  →  Dashboard  →  API keys
# Without these, uploads fall back to local disk storage (development only).
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medconsult
CLOUDINARY_SIGNED_URL_TTL=300

# ---------------------------------------------------------------------------
# Email — Brevo SMTP recommended (300 emails/day free, no card)
# https://app.brevo.com  →  SMTP & API  →  SMTP
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#   SMTP_USER=<your brevo login>     SMTP_PASS=<generated SMTP key>
#
# Gmail alternative (needs 2FA + an App Password, throttles cloud IPs):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
#
# Leave blank in development — emails are logged to the console instead.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MedConsult <no-reply@medconsult.local>

# Controls how mail is handled. Leave blank to send normally via the SMTP
# settings above.
#
#   ethereal  No signup required. Creates a throwaway test inbox on the fly,
#             accepts the message, and returns a public URL where the
#             rendered email can be read. Nothing reaches real recipients.
#             The easiest way to demonstrate the email flow.
#
#   preview   Renders messages locally and sends nothing at all. Used by the
#             test suite. Works offline.
#
# In either mode the rendered messages are readable at GET /api/dev/outbox
# (development only — never mounted when NODE_ENV=production).
MAIL_TRANSPORT=

# ---------------------------------------------------------------------------
# AI Symptom Checker — Google Gemini (free tier, no card in most regions)
# Get a key at https://aistudio.google.com/apikey
# Without a key the checker silently uses its built-in rule engine.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Optional WhatsApp emergency alerts
#
# Email is the primary channel and works without any of this, and the SOS
# screen always offers a one-tap wa.me link that needs no credentials at all.
# Leave WHATSAPP_PROVIDER blank to switch automated WhatsApp off entirely.
#
#   meta       Recommended, and the only one verified to work on a free
#              account. Meta's own WhatsApp Cloud API: no credit card, and a
#              test business number that reaches up to five recipients you
#              verify in the dashboard. Setup is in the README under
#              "WhatsApp alerts"; `npm run whatsapp:meta -- <number>` checks it.
#
#   twilio     Blocked in practice on a Twilio trial account, which refuses any
#              destination that is not a verified caller id (error 572002) and
#              whose current sender demands an approved template per message
#              (21654) that trial accounts cannot create. Works unchanged on a
#              funded account. `npm run whatsapp:probe-twilio` reports which
#              senders an account actually has.
#
#   callmebot  A free community relay. Unofficial, rate-limited, personal use
#              only, and its opt-in endpoint has proved unreliable. Each
#              recipient is issued their own key, stored on the emergency
#              contact in their profile.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API — developers.facebook.com -> your app -> WhatsApp.
# The token is a secret. A dashboard token expires in about 24 hours; create a
# System User token in Business Settings for one that does not.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
# An SOS is business-initiated, so WhatsApp requires an approved template.
# Leave blank to send plain text, which only works inside an open 24h window.
# The template body must contain exactly four placeholders, in this order:
#   {{1}} patient name  {{2}} time  {{3}} map link  {{4}} note
META_WHATSAPP_TEMPLATE=
META_WHATSAPP_TEMPLATE_LANG=en
META_WHATSAPP_API_VERSION=v23.0

# Twilio — from the console dashboard. The auth token is a secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The classic sandbox sender. Replace with an approved number in production.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# CallMeBot — only used when WHATSAPP_PROVIDER=callmebot.
# The key below is a fallback for a single-contact demo; normally each
# emergency contact stores their own.
CALLMEBOT_ENABLED=false
CALLMEBOT_API_KEY=
